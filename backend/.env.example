# FastAPI
APP_NAME=MedGraph AI
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medgraph
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# FalkorDB
FALKOR_HOST=localhost
FALKOR_PORT=6379
FALKOR_GRAPH=hospital_graph
FALKOR_SYNTHEA_GRAPH=medgraph_synthea

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=models/gemini-3.6-flash
GEMINI_MODEL_FALLBACKS=models/gemini-flash-lite-latest

# LLM_PROVIDER=ollama runs entirely on a local model (no data leaves this
# machine) instead of the public Gemini API - see docs/PATH_TO_PRODUCTION.md.
# Requires `ollama serve` running locally with OLLAMA_MODEL pulled.
LLM_PROVIDER=gemini
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# RAG / Vector store
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION=clinical_documents

# Defaults
DEFAULT_HOSPITAL_NAME=MedGraph Super Speciality Hospital

# CORS (comma-separated origins allowed to call this API)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
